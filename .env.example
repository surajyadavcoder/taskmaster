PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017/taskmaster

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

